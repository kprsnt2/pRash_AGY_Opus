# ===== pRash Hub Ultimate Configuration =====

# App Password (required for login)
APP_PASSWORD=changeme

# Primary: OpenAI
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-5.4-mini

# Backup: Google Gemini (also used in Privacy Mode)
GOOGLE_API_KEY=AIza-your-key-here
GOOGLE_MODEL=gemini-flash-latest

# Fallback: Groq (ultra-fast open-source)
GROQ_API_KEY=gsk_your-key-here
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Fallback: NVIDIA NIM (enterprise inference)
NVIDIA_API_KEY=nvapi-your-key-here
NVIDIA_MODEL=meta/llama-3.2-90b-vision-instruct

# Global default model override (optional — bypasses all per-provider models)
# DEFAULT_MODEL=
